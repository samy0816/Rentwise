# ------------------------------------------------------------------
# RentWise backend configuration
# Copy this file to `.env` and fill in the values you need.
# ------------------------------------------------------------------

# --- App ---
APP_NAME=RentWise API
ENVIRONMENT=development
DEBUG=true
# Seed the database with the demo apartment + documents.
SEED_DEMO_DATA=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# --- Database ---
# Production (PostgreSQL + pgvector):
DATABASE_URL=postgresql+psycopg2://rentwise:rentwise@localhost:5432/rentwise
# Local fallback (SQLite) — used automatically when DEMO_MODE is on:
# DATABASE_URL=sqlite:///./rentwise.db

# --- Demo / local mode ---
# When true (or when no LLM/DB is configured) the app runs entirely
# locally: SQLite, a deterministic embedding model and a built-in
# "demo LLM" so the product is demo-able without external services.
DEMO_MODE=false

# --- AI provider ---
# "auto" (default) | "demo" | "openai" | "google".
# "auto" uses Gemini if GEMINI_API_KEY is set, else OpenAI if OPENAI_API_KEY is
# set, else falls back to fully-local demo mode.
AI_PROVIDER=auto

# --- AI (OpenAI) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- AI (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Uploads ---
UPLOAD_DIR=./data/uploads
